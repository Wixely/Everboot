{
  "version": "0.2.0",
  "configurations": [
    {
      "name": ".NET: PXE streaming probe (no attached media)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build:pxe-probe",
      "program": "${workspaceFolder}/tools/PxeProbe/bin/Debug/net10.0/PxeProbe.dll",
      "args": ["${input:pxeIso}", "${input:pxeOutput}", "--ram", "1024"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": ".NET: QEMU integration checks",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build:vm-probe",
      "program": "${workspaceFolder}/tools/VmProbe/bin/Debug/net10.0/VmProbe.dll",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": ".NET: QEMU client",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Everboot/bin/Debug/net10.0/Everboot.dll",
      "args": ["--client", "http://localhost:8080"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": ".NET: Launch Everboot (Debug)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Everboot/bin/Debug/net10.0/Everboot.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/Everboot",
      "stopAtEntry": false,
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "logging": {
        "moduleLoad": false,
        "engineLogging": false
      },
      "env": {
        "DOTNET_ENVIRONMENT": "Development",
        "EVERBOOT_LOG_DIR": "${workspaceFolder}/logs",
        "Everboot__DataDirectory": "${workspaceFolder}/data"
      }
    },
    {
      "name": ".NET: Streaming integration checks",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build:streaming-probe",
      "program": "${workspaceFolder}/tools/StreamingProbe/bin/Debug/net10.0/StreamingProbe.dll",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": ".NET: Attach",
      "type": "coreclr",
      "request": "attach"
    }
  ],
  "inputs": [
    { "id": "pxeIso", "type": "promptString", "description": "Path to the server-side live ISO" },
    { "id": "pxeOutput", "type": "promptString", "description": "New directory for retained PXE test artifacts" }
  ]
}
